# Set default behavior to automatically normalize line endings
* text=auto

# Python files
*.py text eol=lf
*.pyx text eol=lf
*.pyi text eol=lf

# Jupyter notebooks
*.ipynb text eol=lf

# Config files
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf

# Shell scripts
*.sh text eol=lf

# Documentation
*.rst text eol=lf
*.txt text eol=lf

# Binary files
*.db binary
*.duckdb binary
*.parquet binary
*.pickle binary
*.pkl binary

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text

# Archives
*.zip binary
*.tar binary
*.gz binary
*.tgz binary
*.bz2 binary
