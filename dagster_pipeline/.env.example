# Dagster Pipeline Environment Variables

# Binance API credentials (optional, for higher rate limits)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Database configuration
DB_PATH=binance_pipeline.duckdb
DATASET_NAME=binance_data

# Data quality thresholds
DUPLICATE_THRESHOLD=1000
GAP_THRESHOLD_HOURS=6.0
FRESHNESS_THRESHOLD_HOURS=2.0

# Historical data settings
HISTORICAL_START_DATE=2024-10-01
MAX_RECORDS_PER_CHUNK=50000

# Order book settings
ORDER_BOOK_DEPTH=20
