   "source": [
    "from binance_tick_data.sources.websocket import realtime_agg_trades\n",
    "\n",
    "async def stream_agg_trades_example(symbols, duration_seconds=10):\n",
    "    \"\"\"\n",
    "    Stream aggregated trades in real-time.\n",
    "    \n",
    "    Aggregated trades are more efficient and recommended for most use cases.\n",
    "    \"\"\"\n",
    "    \n",
    "    print(f\"Streaming aggregated trades for {symbols}\")\n",
    "    print(f\"Duration: {duration_seconds} seconds\\n\")\n",
    "    \n",
    "    trades_received = []\n",
    "    start_time = datetime.now()\n",
    "    \n",
    "    # Track statistics\n",
    "    stats = {symbol: {'count': 0, 'volume': 0, 'dollar_volume': 0} for symbol in symbols}\n",
    "    \n",
    "    try:\n",
    "        async for agg_trade in realtime_agg_trades(\n",
    "            symbols=symbols,\n",
    "            buffer_size=1000\n",
    "        ):\n",
    "            trades_received.append(agg_trade)\n",
    "            \n",
    "            # Update stats\n",
    "            stats[agg_trade.symbol]['count'] += 1\n",
    "            stats[agg_trade.symbol]['volume'] += agg_trade.quantity\n",
    "            stats[agg_trade.symbol]['dollar_volume'] += agg_trade.price * agg_trade.quantity\n",
    "            \n",
    "            # Stop after duration\n",
    "            if (datetime.now() - start_time).total_seconds() >= duration_seconds:\n",
    "                break\n",
    "        \n",
    "        print(f\"✓ Received {len(trades_received)} aggregated trades\\n\")\n",
    "        \n",
    "        # Print statistics\n",
    "        print(\"Statistics by symbol:\")\n",
    "        print(\"=\"*60)\n",
    "        for symbol, symbol_stats in stats.items():\n",
    "            print(f\"\\n{symbol}:\")\n",
    "            print(f\"  Trades: {symbol_stats['count']:,}\")\n",
    "            print(f\"  Volume: {symbol_stats['volume']:.4f}\")\n",
    "            print(f\"  Dollar volume: ${symbol_stats['dollar_volume']:,.2f}\")\n",
    "        \n",
    "        return trades_received\n",
    "    \n",
    "    except Exception as e:\n",
    "        print(f\"❌ Error: {e}\")\n",
    "        return trades_received\n",
    "\n",
    "print(\"Function defined: stream_agg_trades_example()\")\n",
    "print(\"\\n⚠️  Uncomment to run (opens WebSocket connection):\")\n",
    "\n",
    "# Uncomment to run:\n",
    "# agg_trades = await stream_agg_trades_example(['BTCUSDT', 'ETHUSDT'], duration_seconds=10)"
   ]
