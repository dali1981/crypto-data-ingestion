    "## 8. Rate Limiting & Best Practices"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print(\"Binance API Rate Limits\")\n",
    "print(\"=\"*60)\n",
    "print(\"\"\"\n",
    "REST API Limits:\n",
    "  - Weight-based system\n",
    "  - 1200 weight per minute\n",
    "  - Each endpoint has different weight\n",
    "  \n",
    "  Trade endpoints:\n",
    "    - /api/v3/trades: 1 weight\n",
    "    - /api/v3/aggTrades: 1 weight\n",
    "    - /api/v3/depth: 1-50 weight (depends on limit)\n",
    "\nWebSocket Limits:\n",
    "  - Max 5 connections per IP\n",
    "  - Max 1024 streams per connection\n",
    "  - Reconnect with exponential backoff\n",
    "\n",
    "Best Practices:\n",
    "\"\"\")\n",
    "\n",
    "practices = [\n",
    "    \"1. Use aggregated trades instead of individual trades\",\n",
    "    \"2. Batch API requests when possible\",\n",
    "    \"3. Implement exponential backoff on errors\",\n",
    "    \"4. Use WebSocket for real-time data (more efficient)\",\n",
    "    \"5. Cache frequently accessed data locally\",\n",
    "    \"6. Monitor rate limit headers in responses\",\n",
    "    \"7. Use read-only mode for queries (prevents accidental writes)\",\n",
    "    \"8. Close database connections properly (use context managers)\",\n",
    "    \"9. Process data in chunks for large datasets\",\n",
    "    \"10. Use appropriate time ranges to minimize data transfer\"\n",
    "]\n",
    "\n",
    "for practice in practices:\n",
    "    print(f\"  ✓ {practice}\")"
   ]
  },
