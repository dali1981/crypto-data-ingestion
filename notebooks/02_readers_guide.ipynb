   "source": [
    "from binance_tick_data.sources.websocket import realtime_trades\n",
    "\n",
    "async def stream_trades_example(symbols, duration_seconds=10):\n",
    "    \"\"\"\n",
    "    Stream real-time trades from WebSocket.\n",
    "    \n",
    "    Parameters:\n",
    "    - symbols: List of trading pairs\n",
    "    - duration_seconds: How long to stream\n",
    "    \"\"\"\n",
    "    \n",
    "    print(f\"Streaming trades for {symbols}\")\n",
    "    print(f\"Duration: {duration_seconds} seconds\\n\")\n",
    "    \n",
    "    trades_received = []\n",
    "    start_time = datetime.now()\n",
    "    \n",
    "    try:\n",
    "        # Create async generator\n",
    "        async for trade in realtime_trades(\n",
    "            symbols=symbols,\n",
    "            buffer_size=1000\n",
    "        ):\n",
    "            trades_received.append(trade)\n",
    "            \n",
    "            # Print every 10th trade\n",
    "            if len(trades_received) % 10 == 0:\n",
    "                print(f\"  {trade.symbol}: ${trade.price:,.2f} x {trade.quantity:.4f} \"\n",
    "                      f\"[{'SELL' if trade.is_buyer_maker else 'BUY'}]\")\n",
    "            \n",
    "            # Stop after duration\n",
    "            if (datetime.now() - start_time).total_seconds() >= duration_seconds:\n",
    "                break\n",
    "        \n",
    "        print(f\"\\n✓ Received {len(trades_received)} trades in {duration_seconds}s\")\n",
    "        print(f\"  Rate: {len(trades_received)/duration_seconds:.1f} trades/second\")\n",
    "        \n",
    "        return trades_received\n",
    "    \n",
    "    except Exception as e:\n",
    "        print(f\"❌ Error: {e}\")\n",
    "        return trades_received\n",
    "\n",
    "print(\"Function defined: stream_trades_example()\")\n",
    "print(\"\\n⚠️  Uncomment to run (opens WebSocket connection):\")\n",
    "\n",
