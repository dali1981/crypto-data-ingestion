    "### 2.3 Order Book Snapshots\n",
    "\n",
    "Fetch point-in-time order book depth."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from binance_tick_data.sources.rest_api import order_book_snapshots\n",
    "\n",
    "def fetch_order_book_example(symbol, depth_levels=20):\n",
    "    \"\"\"\n",
    "    Fetch current order book snapshot.\n",
    "    \n",
    "    Parameters:\n",
    "    - symbol: Trading pair\n",
    "    - depth_levels: Number of price levels (5, 10, 20, 50, 100, 500, 1000, 5000)\n",
    "    \"\"\"\n",
    "    \n",
    "    print(f\"Fetching order book for {symbol}\")\n",
    "    print(f\"  Depth levels: {depth_levels}\\n\")\n",
    "    \n",
    "    try:\n",
    "        # Generator yields snapshots\n",
    "        for snapshot_batch in order_book_snapshots(\n",
    "            symbol=symbol,\n",
    "            depth_levels=depth_levels\n",
    "        ):\n",
    "            # Usually just one snapshot\n",
    "            if snapshot_batch:\n",
    "                snapshot = snapshot_batch[0]\n",
    "                \n",
    "                print(f\"✓ Order book snapshot received\")\n",
    "                print(f\"  Timestamp: {snapshot.timestamp}\")\n",
    "                print(f\"  Last update ID: {snapshot.last_update_id}\")\n",
    "                print(f\"\\n  Top 5 Bids:\")\n",
    "                for price, qty in snapshot.bids[:5]:\n",
    "                    print(f\"    ${price:,.2f} x {qty:.4f}\")\n",
    "                \n",
    "                print(f\"\\n  Top 5 Asks:\")\n",
    "                for price, qty in snapshot.asks[:5]:\n",
    "                    print(f\"    ${price:,.2f} x {qty:.4f}\")\n",
    "                \n",
    "                # Calculate spread\n",
    "                best_bid = snapshot.bids[0][0] if snapshot.bids else 0\n",
    "                best_ask = snapshot.asks[0][0] if snapshot.asks else 0\n",
    "                spread = best_ask - best_bid\n",
    "                spread_bps = (spread / best_bid) * 10000 if best_bid > 0 else 0\n",
    "                \n",
    "                print(f\"\\n  Spread: ${spread:.2f} ({spread_bps:.2f} bps)\")\n",
    "                \n",
    "                return snapshot\n",
    "            \n",
    "            break\n",
    "    \n",
    "    except Exception as e:\n",
    "        print(f\"❌ Error: {e}\")\n",
    "        return None\n",
    "\n",
    "print(\"Function defined: fetch_order_book_example()\")\n",
    "print(\"\\n⚠️  Uncomment to run (makes API call):\")\n",
    "\n",
    "# Uncomment to run:\n",
    "# snapshot = fetch_order_book_example('BTCUSDT', depth_levels=20)"
