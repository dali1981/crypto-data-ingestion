    "### 4.3 Incremental Updates\n",
    "\n",
    "Efficiently update existing data with new records."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def incremental_update_example(symbol):\n",
    "    \"\"\"\n",
    "    Demonstrate incremental data updates.\n",
    "    \n",
    "    This fetches only new data since the last update.\n",
    "    \"\"\"\n",
    "    \n",
    "    print(\"Incremental Update Pipeline\")\n",
    "    print(\"=\"*60)\n",
    "    \n",
    "    with BinanceDataRepository(read_only=True) as repo:\n",
    "        try:\n",
    "            # Get latest timestamp in database\n",
    "            df = repo.get_agg_trades(\n",
    "                symbol=symbol,\n",
    "                limit=1,\n",
    "                return_dataframe=True\n",
    "            )\n",
    "            \n",
    "            if not df.empty:\n",
    "                last_timestamp = df['timestamp'].max()\n",
    "                print(f\"Last record in database: {last_timestamp}\")\n",
    "                \n",
    "                # Fetch new data from that point forward\n",
    "                print(f\"\\nFetching new data since {last_timestamp}...\")\n",
    "                \n",
    "                source = binance_historical_data(\n",
    "                    config=config.pipeline,\n",
    "                    symbols=[symbol],\n",
    "                    start_date=last_timestamp\n",
    "                )\n",
    "                \n",
    "                print(\"✓ Incremental source created\")\n",
    "                print(\"\\nThis will only fetch records newer than the last timestamp.\")\n",
    "                \n",
    "                return source\n",
    "            else:\n",
    "                print(\"⚠️  No existing data found. Use full historical load.\")\n",
    "                return None\n",
    "        \n",
    "        except Exception as e:\n",
    "            print(f\"❌ Error: {e}\")\n",
    "            return None\n",
    "\n",
    "# Example\n",
    "inc_source = incremental_update_example('BTCUSDT')"
   ]
  },
