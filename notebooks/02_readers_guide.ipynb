   "source": [
    "from binance_tick_data.errors import (\n",
    "    BinanceDataError,\n",
    "    NoDataFoundError,\n",
    "    InvalidSymbolError,\n",
    "    DatabaseError,\n",
    "    APIError,\n",
    "    RateLimitError\n",
    ")\n",
    "\n",
    "print(\"Error Handling Best Practices\")\n",
    "print(\"=\"*60)\n",
    "\n",
    "def robust_data_fetch(symbol, days=7):\n",
    "    \"\"\"\n",
    "    Example of robust error handling for data fetching.\n",
    "    \"\"\"\n",
    "    \n",
    "    retry_count = 0\n",
    "    max_retries = 3\n",
    "    \n",
    "    while retry_count < max_retries:\n",
    "        try:\n",
    "            with BinanceDataRepository(read_only=True) as repo:\n",
    "                df = repo.get_agg_trades_by_date_range(\n",
    "                    symbol=symbol,\n",
    "                    days=days,\n",
    "                    return_dataframe=True\n",
    "                )\n",
    "                \n",
    "                print(f\"✓ Successfully fetched {len(df):,} trades\")\n",
    "                return df\n",
    "        \n",
    "        except NoDataFoundError as e:\n",
    "            print(f\"⚠️  No data: {e}\")\n",
    "            print(\"   Suggestion: Check symbol and date range\")\n",
    "            return None\n",
    "        \n",
    "        except InvalidSymbolError as e:\n",
    "            print(f\"❌ Invalid symbol: {e}\")\n",
    "            print(\"   Suggestion: Use format like 'BTCUSDT'\")\n",
    "            return None\n",
    "        \n",
    "        except DatabaseError as e:\n",
    "            print(f\"❌ Database error: {e}\")\n",
    "            print(\"   Suggestion: Check database path and permissions\")\n",
    "            return None\n",
    "        \n",
    "        except RateLimitError as e:\n",
    "            retry_count += 1\n",
    "            wait_time = 2 ** retry_count  # Exponential backoff\n",
    "            print(f\"⚠️  Rate limit hit. Waiting {wait_time}s... (Retry {retry_count}/{max_retries})\")\n",
    "            import time\n",
    "            time.sleep(wait_time)\n",
    "        \n",
    "        except BinanceDataError as e:\n",
    "            print(f\"❌ General error: {e}\")\n",
    "            return None\n",
    "        \n",
    "        except Exception as e:\n",
    "            print(f\"❌ Unexpected error: {type(e).__name__}: {e}\")\n",
    "            return None\n",
    "    \n",
    "    print(f\"❌ Failed after {max_retries} retries\")\n",
    "    return None\n",
    "\n",
    "print(\"Function defined: robust_data_fetch()\")\n",
    "print(\"\\nThis function demonstrates:\")\n",
    "print(\"  ✓ Specific exception handling\")\n",
    "print(\"  ✓ Retry logic with exponential backoff\")\n",
    "print(\"  ✓ Helpful error messages\")\n",
    "print(\"  ✓ Context manager usage\")\n",
    "print(\"  ✓ Graceful degradation\")"
   ]
