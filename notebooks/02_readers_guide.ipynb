    "from binance_tick_data.sources.websocket import realtime_depth\n",
    "\n",
    "async def stream_depth_example(symbols, duration_seconds=10, update_speed='100ms'):\n",
    "    \"\"\"\n",
    "    Stream order book depth updates.\n",
    "    \n",
    "    Parameters:\n",
    "    - symbols: List of trading pairs\n",
    "    - duration_seconds: How long to stream\n",
    "    - update_speed: '100ms' or '1000ms'\n",
    "    \"\"\"\n",
    "    \n",
    "    print(f\"Streaming depth for {symbols}\")\n",
    "    print(f\"Update speed: {update_speed}\")\n",
    "    print(f\"Duration: {duration_seconds} seconds\\n\")\n",
    "    \n",
    "    updates_received = []\n",
    "    start_time = datetime.now()\n",
    "    \n",
    "    try:\n",
    "        async for depth_update in realtime_depth(\n",
    "            symbols=symbols,\n",
    "            update_speed=update_speed\n",
    "        ):\n",
    "            updates_received.append(depth_update)\n",
    "            \n",
    "            # Print every 10th update\n",
    "            if len(updates_received) % 10 == 0:\n",
    "                print(f\"  {depth_update.symbol}: Update #{depth_update.final_update_id}\")\n",
    "                print(f\"    Bids: {len(depth_update.bids)} levels\")\n",
