    "## 4. DLT Pipeline Integration\n",
    "\n",
    "Use DLT (Data Load Tool) for robust data ingestion pipelines.\n",
    "\n",
    "### 4.1 Historical Data Pipeline"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from binance_tick_data.sources.rest_api import binance_historical_data\n",
    "\n",
    "def run_historical_pipeline_example(symbols, days_back=7):\n",
    "    \"\"\"\n",
    "    Run DLT pipeline to load historical data into DuckDB.\n",
    "    \n",
    "    This is the recommended way to bulk-load historical data.\n",
    "    \"\"\"\n",
    "    \n",
    "    print(\"Historical Data Pipeline\")\n",
    "    print(\"=\"*60)\n",
    "    print(f\"Symbols: {symbols}\")\n",
    "    print(f\"Date range: Last {days_back} days\")\n",
    "    print(f\"\\nPipeline configuration:\")\n",
    "    print(f\"  Destination: DuckDB\")\n",
    "    print(f\"  Database: {config.database.db_path}\")\n",
    "    print(f\"  Schema: {config.database.table.schema}\")\n",
    "    \n",
    "    try:\n",
    "        # Create DLT source\n",
    "        source = binance_historical_data(\n",
    "            config=config.pipeline,\n",
    "            symbols=symbols,\n",
    "            start_date=datetime.now() - timedelta(days=days_back)\n",
