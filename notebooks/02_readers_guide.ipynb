    "## 10. Performance Optimization"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import time\n",
    "\n",
    "print(\"Performance Optimization Tips\")\n",
    "print(\"=\"*60)\n",
    "\n",
    "# Tip 1: Use tuples instead of DataFrames for large queries\n",
    "print(\"\\n1. DataFrame vs Tuples Performance\")\n",
    "print(\"-\" * 60)\n",
    "\n",
    "with BinanceDataRepository(read_only=True) as repo:\n",
    "    # DataFrame\n",
    "    start = time.time()\n",
    "    df = repo.get_agg_trades(\n",
    "        symbol='BTCUSDT',\n",
    "        limit=10000,\n",
    "        return_dataframe=True\n",
    "    )\n",
    "    df_time = time.time() - start\n",
    "    \n",
    "    # Tuples\n",
    "    start = time.time()\n",
    "    tuples = repo.get_agg_trades(\n",
    "        symbol='BTCUSDT',\n",
    "        limit=10000,\n",
    "        return_dataframe=False\n",
    "    )\n",
    "    tuple_time = time.time() - start\n",
    "    \n",
    "    print(f\"DataFrame: {df_time:.4f}s\")\n",
    "    print(f\"Tuples: {tuple_time:.4f}s\")\n",
    "    print(f\"Speedup: {df_time/tuple_time:.2f}x\")\n",
    "    print(\"\\n💡 Tip: Use tuples for large queries, convert to DataFrame if needed\")\n",
    "\n",
    "# Tip 2: Use appropriate LIMIT\n",
    "print(\"\\n2. Query Limit Impact\")\n",
    "print(\"-\" * 60)\n",
    "print(\"Always use LIMIT to prevent loading unnecessary data:\")\n",
    "print(\"\"\"\n",
    "# Good\n",
    "df = repo.get_agg_trades(symbol='BTCUSDT', limit=10000)\n",
    "\n",
    "# Bad (loads everything)\n",
    "df = repo.get_agg_trades(symbol='BTCUSDT')  # No limit!\n",
    "\"\"\")\n",
    "\n",
    "# Tip 3: Use specific time ranges\n",
    "print(\"\\n3. Time Range Queries\")\n",
    "print(\"-\" * 60)\n",
    "print(\"Specify time ranges to reduce query scope:\")\n",
    "print(\"\"\"\n",
    "# Good\n",
    "df = repo.get_agg_trades(\n",
    "    symbol='BTCUSDT',\n",
    "    start_time=datetime.now() - timedelta(hours=1),\n",
    "    end_time=datetime.now()\n",
    ")\n",
    "\n",
    "# Less efficient (scans all data)\n",
    "df = repo.get_agg_trades(symbol='BTCUSDT', limit=1000)\n",
    "\"\"\")\n",
    "\n",
    "# Tip 4: Batch processing\n",
    "print(\"\\n4. Batch Processing\")\n",
    "print(\"-\" * 60)\n",
    "print(\"Process large datasets in chunks:\")\n",
    "print(\"\"\"\n",
    "def process_in_chunks(symbol, chunk_hours=1):\n",
    "    end = datetime.now()\n",
    "    start = end - timedelta(days=7)\n",
    "    \n",
    "    current = start\n",
    "    while current < end:\n",
    "        chunk_end = min(current + timedelta(hours=chunk_hours), end)\n",
    "        \n",
    "        # Process chunk\n",
    "        df_chunk = repo.get_agg_trades(\n",
    "            symbol=symbol,\n",
    "            start_time=current,\n",
    "            end_time=chunk_end\n",
    "        )\n",
    "        \n",
    "        # Do something with chunk\n",
    "        process_chunk(df_chunk)\n",
    "        \n",
    "        current = chunk_end\n",
    "\"\"\")\n",
    "\n",
    "# Tip 5: Connection pooling\n",
    "print(\"\\n5. Connection Management\")\n",
    "print(\"-\" * 60)\n",
    "print(\"Always use context managers:\")\n",
    "print(\"\"\"\n",
    "# Good\n",
    "with BinanceDataRepository(read_only=True) as repo:\n",
    "    df = repo.get_agg_trades('BTCUSDT')\n",
    "    # Connection automatically closed\n",
    "\n",
    "# Bad\n",
    "repo = BinanceDataRepository()\n",
    "df = repo.get_agg_trades('BTCUSDT')\n",
    "# Connection may leak!\n",
    "\"\"\")"
   ]
