    "## 6. Custom Data Sources\n",
    "\n",
    "Create custom data sources for specific needs."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import dlt\n",
    "from typing import Iterator\n",
    "\n",
    "@dlt.source\n",
    "def custom_data_source(\n",
    "    symbols: List[str],\n",
    "    custom_filter: Optional[callable] = None\n",
    "):\n",
    "    \"\"\"\n",
    "    Example of a custom DLT data source.\n",
    "    \n",
    "    This demonstrates how to create your own data source\n",
    "    with custom filtering and transformation logic.\n",
    "    \"\"\"\n",
    "    \n",
    "    @dlt.resource(write_disposition=\"append\")\n",
    "    def filtered_trades(symbol: str) -> Iterator[Dict]:\n",
    "        \"\"\"\n",
    "        Resource that yields filtered trade data.\n",
    "        \"\"\"\n",
    "        \n",
    "        # Fetch trades using aggregated_trades\n",
    "        for batch in aggregated_trades(\n",
    "            symbol=symbol,\n",
    "            start_date=datetime.now() - timedelta(hours=1),\n",
    "            limit=1000\n",
    "        ):\n",
    "            for trade in batch:\n",
    "                # Apply custom filter\n",
    "                if custom_filter is None or custom_filter(trade):\n",
    "                    # Convert to dict and yield\n",
    "                    yield trade.dict()\n",
    "    \n",
    "    # Return resources for each symbol\n",
    "    return [filtered_trades(symbol) for symbol in symbols]\n",
    "\n",
    "print(\"Custom data source defined: custom_data_source()\")\n",
    "print(\"\\nExample usage:\")\n",
    "print(\"\"\"\n",
    "# Define custom filter\n",
    "def large_trades_only(trade):\n",
    "    return trade.quantity > 1.0\n",
    "\n",
    "# Create source\n",
    "source = custom_data_source(\n",
    "    symbols=['BTCUSDT'],\n",
    "    custom_filter=large_trades_only\n",
    ")\n",
    "\n",
    "# Run pipeline\n",
    "pipeline = dlt.pipeline(\n",
    "    pipeline_name=\"custom_pipeline\",\n",
    "    destination=\"duckdb\",\n",
    "    dataset_name=\"custom_data\"\n",
    ")\n",
    "pipeline.run(source)\n",
    "\"\"\")"
   ]
  },
